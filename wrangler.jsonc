{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gruposole",
  "compatibility_date": "2026-10-01",
  // El sitio se genera con scripts/build.mjs (Node, sin dependencias) antes de cada
  // `wrangler dev` y `wrangler deploy`. Cloudflare Workers Builds lo ejecuta solo.
  "build": {
    "command": "node scripts/build.mjs"
  },
  // Sitio estático: Workers Static Assets, sin script de Worker.
  "assets": {
    "directory": "./dist",
    // /nosotros -> /nosotros/ (URLs con slash final, como en WordPress)
    "html_handling": "auto-trailing-slash",
    // Rutas inexistentes -> dist/404.html con estado 404
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "gruposole.com.co", "custom_domain": true },
    { "pattern": "www.gruposole.com.co", "custom_domain": true }
  ]
}
